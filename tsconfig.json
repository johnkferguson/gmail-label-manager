{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["google-apps-script", "vitest/globals"]
  },
  "include": ["src/**/*.js", "test/**/*.js", "vitest.config.js"],
  "exclude": ["node_modules"]
}
