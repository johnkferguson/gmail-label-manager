{
  "name": "gmail-label-manager",
  "version": "0.2.0",
  "description": "Manage your Gmail labels via a Google Sheet — a Google Apps Script add-on.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "John K. Ferguson",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnkferguson/gmail-label-manager.git"
  },
  "scripts": {
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "push": "clasp push",
    "pull": "clasp pull"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.9",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
